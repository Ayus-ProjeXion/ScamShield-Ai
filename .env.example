# ==============================================================================
# SCAMSHIELD AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in your credentials:
# cp .env.example .env
# ==============================================================================

# Core Application Settings
PROJECT_NAME="ScamShield AI"
VERSION="1.0.0"
SECRET_KEY="scamshield-super-secret-hmac-key-2026"

# Supabase Cloud Database Configuration
# Obtain from: https://supabase.com -> Project Settings -> API
# 1. Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Public Anon Key (Project API Keys -> anon public)
SUPABASE_KEY=your-anon-public-key-here

# 3. Service Role Key (optional, for backend admin operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
